rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && profile().data.status == 'active';
    }

    function admin() {
      return activeUser() && profile().data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /patrolReports/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /assets/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /findings/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /areas/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /recommendations/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /activities/{documentId} {
      allow read: if activeUser();
      allow create: if admin();
      allow update, delete: if false;
    }

    match /reportExports/{documentId} {
      allow read, create: if activeUser();
      allow update, delete: if admin();
    }
  }
}

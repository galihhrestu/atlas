# Salin file ini menjadi .env untuk penggunaan lokal.
# Jangan pernah mengunggah file .env ke GitHub atau membagikannya.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# ATLAS memakai port 5173; frontend K3 dijalankan di port 5174.
CORS_ORIGIN=http://localhost:5174

# Contoh PostgreSQL lokal:
DATABASE_URL="postgresql://postgres:password@localhost:5432/insight_k3?schema=public"

# Batas maksimum koneksi aplikasi ke PostgreSQL.
DATABASE_POOL_SIZE=10

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  OPERATOR
  MANAGEMENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  PENDING
  REJECTED
  INVESTIGATION
  CORRECTIVE_ACTION
  MANAGEMENT_REVIEW
  REVISION_REQUIRED
  CLOSED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ControlHierarchy {
  ELIMINATION
  SUBSTITUTION
  ENGINEERING_CONTROL
  ADMINISTRATIVE_CONTROL
  PPE
}

enum EffectivenessStatus {
  NOT_REVIEWED
  MONITORING
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

enum ManagementReviewStatus {
  WAITING_REVIEW
  REVISION_REQUIRED
  APPROVED_AND_CLOSED
}

enum AttachmentCategory {
  INCIDENT_EVIDENCE
  INVESTIGATION_EVIDENCE
  CORRECTIVE_ACTION_EVIDENCE
  MANAGEMENT_ATTACHMENT
}

enum AuditEvent {
  CREATE
  UPDATE
  APPROVE
  REJECT
  SUBMIT
  CLOSE
  LOGIN
  LOGOUT
  EXPORT
  DELETE
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  username             String                @unique @db.VarChar(100)
  email                String                @unique @db.VarChar(255)
  passwordHash         String                @map("password_hash") @db.VarChar(255)
  fullName             String?               @map("full_name") @db.VarChar(200)
  department           String?               @db.VarChar(150)
  role                 UserRole              @default(USER)
  status               UserStatus            @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  reportedIncidents    Incident[]            @relation("IncidentReporter")
  approvedIncidents    Incident[]            @relation("IncidentApprover")
  rejectedIncidents    Incident[]            @relation("IncidentRejector")
  reviewedIncidents    ManagementReview[]    @relation("ManagementReviewer")
  closedIncidents      Incident[]            @relation("IncidentCloser")
  ledInvestigations    Investigation[]       @relation("LeadInvestigator")
  assignedActions      CorrectiveAction[]    @relation("CorrectiveActionPIC")
  investigationUpdates InvestigationUpdate[] @relation("InvestigationUpdateAuthor")
  auditLogs            AuditLog[]            @relation("AuditActor")
  attachments          Attachment[]          @relation("AttachmentUploader")
  authSessions         AuthSession[]

  @@map("users")
}

model Incident {
  id                 String             @id @default(uuid()) @db.Uuid
  incidentCode       String             @unique @map("incident_code") @db.VarChar(40)
  reporterId         String             @map("reporter_id") @db.Uuid
  incidentDate       DateTime           @map("incident_date") @db.Timestamptz(6)
  location           String             @db.VarChar(150)
  estate             String?            @db.VarChar(50)
  locationType       String?            @map("location_type") @db.VarChar(50)
  block              String?            @db.VarChar(10)
  compartment        String?            @db.VarChar(20)
  haulingRoad        String?            @map("hauling_road") @db.VarChar(150)
  compartmentRoad    String?            @map("compartment_road") @db.VarChar(100)
  locationDetail     String?            @map("location_detail") @db.VarChar(255)
  department         String             @db.VarChar(150)
  type               String             @db.VarChar(150)
  severity           IncidentSeverity   @default(LOW)
  objectInvolved     String?            @map("object_involved") @db.VarChar(255)
  description        String             @db.Text
  unsafeAction       String?            @map("unsafe_action") @db.VarChar(255)
  sopViolation       Boolean?           @map("sop_violation")
  unsafeCondition    String?            @map("unsafe_condition") @db.VarChar(255)
  contributingFactor String?            @map("contributing_factor") @db.Text
  rootCauseCategory  String?            @map("root_cause_category") @db.VarChar(150)
  initialRootCause   String?            @map("initial_root_cause") @db.Text
  initialActionPlan  String?            @map("initial_action_plan") @db.Text
  initialPic         String?            @map("initial_pic") @db.VarChar(200)
  initialTargetDate  DateTime?          @map("initial_target_date") @db.Date
  status             IncidentStatus     @default(PENDING)
  rejectionReason    String?            @map("rejection_reason") @db.Text
  rejectedById       String?            @map("rejected_by_id") @db.Uuid
  rejectedAt         DateTime?          @map("rejected_at") @db.Timestamptz(6)
  approvedById       String?            @map("approved_by_id") @db.Uuid
  approvedAt         DateTime?          @map("approved_at") @db.Timestamptz(6)
  closedById         String?            @map("closed_by_id") @db.Uuid
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  reporter           User               @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  approvedBy         User?              @relation("IncidentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy         User?              @relation("IncidentRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  closedBy           User?              @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)
  investigation      Investigation?
  correctiveActions  CorrectiveAction[]
  managementReview   ManagementReview?
  attachments        Attachment[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([severity])
  @@index([department])
  @@index([location])
  @@index([estate])
  @@index([locationType])
  @@index([block, compartment])
  @@index([incidentDate])
  @@map("incidents")
}

model Investigation {
  id                   String                @id @default(uuid()) @db.Uuid
  incidentId           String                @unique @map("incident_id") @db.Uuid
  investigationDate    DateTime?             @map("investigation_date") @db.Timestamptz(6)
  leadInvestigatorId   String?               @map("lead_investigator_id") @db.Uuid
  leadInvestigatorName String?               @map("lead_investigator_name") @db.VarChar(200)
  teamMembers          Json?                 @map("team_members")
  method               String?               @db.VarChar(255)
  verifiedChronology   String?               @map("verified_chronology") @db.Text
  findings             String?               @db.Text
  witnesses            String?               @db.Text
  evidenceDescription  String?               @map("evidence_description") @db.Text
  immediateCause       String?               @map("immediate_cause") @db.Text
  rootCause            String?               @map("root_cause") @db.Text
  contributingFactor   String?               @map("contributing_factor") @db.Text
  fiveWhy              Json?                 @map("five_why")
  actionPlanDraft      Json?                 @map("action_plan_draft")
  progress             Int                   @default(0)
  submittedByName      String?               @map("submitted_by_name") @db.VarChar(200)
  submittedAt          DateTime?             @map("submitted_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  incident             Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  leadInvestigator     User?                 @relation("LeadInvestigator", fields: [leadInvestigatorId], references: [id], onDelete: SetNull)
  correctiveActions    CorrectiveAction[]
  updates              InvestigationUpdate[]
  attachments          Attachment[]

  @@map("investigations")
}

model CorrectiveAction {
  id                  String                 @id @default(uuid()) @db.Uuid
  incidentId          String                 @map("incident_id") @db.Uuid
  investigationId     String?                @map("investigation_id") @db.Uuid
  action              String                 @db.Text
  controlHierarchy    ControlHierarchy?      @map("control_hierarchy")
  picUserId           String?                @map("pic_user_id") @db.Uuid
  picName             String                 @map("pic_name") @db.VarChar(200)
  targetDate          DateTime               @map("target_date") @db.Date
  status              CorrectiveActionStatus @default(OPEN)
  progress            Int                    @default(0)
  evidenceSummary     String?                @map("evidence_summary") @db.Text
  note                String?                @db.Text
  completedAt         DateTime?              @map("completed_at") @db.Timestamptz(6)
  effectivenessStatus EffectivenessStatus    @default(NOT_REVIEWED) @map("effectiveness_status")
  effectivenessNote   String?                @map("effectiveness_note") @db.Text
  reviewedAt          DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  incident            Incident               @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  investigation       Investigation?         @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  picUser             User?                  @relation("CorrectiveActionPIC", fields: [picUserId], references: [id], onDelete: SetNull)
  attachments         Attachment[]

  @@index([incidentId])
  @@index([status])
  @@index([targetDate])
  @@map("corrective_actions")
}

model InvestigationUpdate {
  id              String        @id @default(uuid()) @db.Uuid
  investigationId String        @map("investigation_id") @db.Uuid
  authorId        String?       @map("author_id") @db.Uuid
  authorName      String        @map("author_name") @db.VarChar(200)
  note            String        @db.Text
  progress        Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  author          User?         @relation("InvestigationUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([investigationId, createdAt])
  @@map("investigation_updates")
}

model ManagementReview {
  id           String                 @id @default(uuid()) @db.Uuid
  incidentId   String                 @unique @map("incident_id") @db.Uuid
  status       ManagementReviewStatus @default(WAITING_REVIEW)
  note         String?                @db.Text
  reviewedById String?                @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  incident     Incident               @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reviewedBy   User?                  @relation("ManagementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("management_reviews")
}

model Attachment {
  id                 String             @id @default(uuid()) @db.Uuid
  incidentId         String             @map("incident_id") @db.Uuid
  investigationId    String?            @map("investigation_id") @db.Uuid
  correctiveActionId String?            @map("corrective_action_id") @db.Uuid
  uploadedById       String?            @map("uploaded_by_id") @db.Uuid
  category           AttachmentCategory
  originalName       String             @map("original_name") @db.VarChar(255)
  storageKey         String             @unique @map("storage_key") @db.VarChar(500)
  mimeType           String             @map("mime_type") @db.VarChar(150)
  sizeBytes          Int                @map("size_bytes")
  checksum           String?            @db.VarChar(128)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  incident           Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  investigation      Investigation?     @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  correctiveAction   CorrectiveAction?  @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)
  uploadedBy         User?              @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([category])
  @@map("attachments")
}

model AuditLog {
  id            String     @id @default(uuid()) @db.Uuid
  actorId       String?    @map("actor_id") @db.Uuid
  actorUsername String     @map("actor_username") @db.VarChar(100)
  actorRole     String     @map("actor_role") @db.VarChar(50)
  module        String     @db.VarChar(100)
  action        AuditEvent
  recordType    String     @map("record_type") @db.VarChar(100)
  recordId      String     @map("record_id") @db.VarChar(100)
  incidentId    String?    @map("incident_id") @db.Uuid
  description   String     @db.Text
  previousValue Json?      @map("previous_value")
  newValue      Json?      @map("new_value")
  ipAddress     String?    @map("ip_address") @db.VarChar(64)
  userAgent     String?    @map("user_agent") @db.Text
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  actor         User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  incident      Incident?  @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([module, action])
  @@index([recordType, recordId])
  @@index([incidentId])
  @@map("audit_logs")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

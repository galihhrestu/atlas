# Local development uses the root path. GitHub Pages sets this automatically in Actions.
VITE_BASE_PATH=/

# ATLAS map configuration.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# SIGMA demo mode. Keep local until Firebase is configured.
VITE_DATA_MODE=local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL frontend INSIGHT K3 setelah dideploy secara terpisah.
# Kosongkan jika backend/frontend Insight K3 belum dipasang di server.
VITE_INSIGHT_K3_URL=
